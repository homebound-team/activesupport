{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ESNext",
    "types": ["jest", "node"],
    "moduleResolution": "node",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["dist", "node_modules"]
}
